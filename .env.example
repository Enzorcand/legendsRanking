# Copy this file to .env and replace the placeholder password.
POSTGRES_DB=aaac_ranking
POSTGRES_USER=aaac_ranking
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_PORT=5432
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev
RIOT_API_KEY=troque-pela-sua-riot-api-key
RIOT_PLATFORM=br1
RIOT_CONTINENT=americas
# MAIL_HOST/MAIL_PORT valem para rodar a aplicacao FORA do Docker (./gradlew bootRun),
# apontando para o Mailpit publicado pelo docker-compose em localhost:1025.
# Quando a API roda DENTRO do compose (servico "api"), ela usa o servico "mailpit" pelo nome,
# configurado direto no docker-compose.yml - essas variaveis nao se aplicam nesse caso.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@aaac-ranking.pucrs.br
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
